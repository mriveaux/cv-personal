---
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  about: string;
}

const { title, about } = Astro.props;
---
<section id="about" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="user" />
    {title}
  </h2>
  <p class="border-l-4 border-indigo-500 pl-4 leading-relaxed text-slate-700 dark:border-indigo-400 dark:text-slate-300">{about}</p>
</section>
