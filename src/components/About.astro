---
interface Props {
  title: string;
  about: string;
}

const { title, about } = Astro.props;
---
<section id="about" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <span class="h-6 w-1 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500"></span>
    {title}
  </h2>
  <p class="leading-relaxed text-slate-700 dark:text-slate-300">{about}</p>
</section>
