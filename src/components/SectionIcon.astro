---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---
<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-indigo-500 to-violet-500 text-white">
  <Icon name={name} class="h-3.5 w-3.5" />
</span>
