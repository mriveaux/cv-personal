---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  items: CvData['certifications'];
}

const { title, items } = Astro.props;
---
<section id="certifications" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="badge-check" />
    {title}
  </h2>
  <div class="space-y-3">
    {items.map((cert, i) => (
      <div
        class="group/cert stagger-item relative overflow-hidden rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:-translate-y-0.5 hover:scale-[1.01] hover:border-indigo-200 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-800"
        style={`--stagger-index: ${i}`}
      >
        <p class="font-semibold text-slate-900 dark:text-slate-100">
          {cert.url ? (
            <a href={cert.url} class="group/link inline-flex items-center gap-0.5 text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300" target="_blank" rel="noopener">
              {cert.name}
              <Icon name="external-link" class="h-3 w-3 opacity-0 transition-opacity group-hover/link:opacity-100" />
            </a>
          ) : ( cert.name )}
        </p>
        <p class="text-slate-600 dark:text-slate-400">{cert.issuer} · {cert.date}</p>
        {cert.credentialId && <p class="text-xs text-slate-400 dark:text-slate-500">ID: {cert.credentialId}</p>}
        {cert.badgeImage && (
          <a
            href={cert.url}
            target="_blank"
            rel="noopener"
            class="no-print absolute right-4 top-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200 group-hover/cert:opacity-100"
          >
            <img
              src={`/badges/${cert.badgeImage}`}
              alt={cert.name}
              width="300"
              height="206"
              loading="lazy"
              class="h-16 w-auto rounded-md shadow-md transition-transform hover:scale-105"
            />
          </a>
        )}
      </div>
    ))}
  </div>
</section>
