---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<button
  type="button"
  class="no-print rounded-md bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-opacity hover:opacity-90"
  onclick="window.print()"
>
  {label}
</button>
