---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';
import Flag from './Flag.astro';

interface Props {
  title: string;
  items: CvData['languages'];
}

const { title, items } = Astro.props;
---
<section id="languages" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="language" />
    {title}
  </h2>
  <ul class="flex flex-wrap gap-4">
    {items.map((language) => (
      <li class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
        {language.code && <Flag code={language.code} class="h-3.5 w-5" />}
        <span><span class="font-semibold text-slate-900 dark:text-slate-100">{language.name}:</span> {language.level}</span>
      </li>
    ))}
  </ul>
</section>
