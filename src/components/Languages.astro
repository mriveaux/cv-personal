---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';
import Flag from './Flag.astro';

interface Props {
  title: string;
  items: CvData['languages'];
}

const { title, items } = Astro.props;
---
<section id="languages" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="language" />
    {title}
  </h2>
  <ul class="flex flex-wrap gap-6">
    {items.map((language) => (
      <li class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
        {language.code && <Flag code={language.code} class="h-3.5 w-5" />}
        <span class="font-semibold text-slate-900 dark:text-slate-100">{language.name}</span>
        <span
          class="group relative inline-flex items-center gap-1 py-1"
          tabindex="0"
          role="img"
          aria-label={language.level}
        >
          {Array.from({ length: 5 }).map((_, i) => (
            <span
              class:list={[
                'h-2 w-2 rounded-full transition-colors',
                i < language.levelValue
                  ? 'bg-gradient-to-b from-indigo-500 to-violet-500'
                  : 'bg-slate-200 dark:bg-slate-700',
              ]}
            />
          ))}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-slate-900 px-2 py-1 text-xs font-medium text-white opacity-0 shadow-md transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100 dark:bg-slate-700"
          >
            {language.level}
          </span>
        </span>
        <span class="hidden text-sm text-slate-500 print:inline dark:text-slate-400">({language.level})</span>
      </li>
    ))}
  </ul>
</section>
