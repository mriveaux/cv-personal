---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../site';
import { getLocalizedPath } from '../i18n/langs';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Certifications from './Certifications.astro';
import Courses from './Courses.astro';
import Patents from './Patents.astro';
import Languages from './Languages.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/langs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) {
  throw new Error(`Missing CV content for locale "${lang}"`);
}
const cv = entry.data;

const OG_LOCALES: Record<Lang, string> = {
  es: 'es_ES',
  en: 'en_US',
  ca: 'ca_ES',
  pt: 'pt_PT',
  fr: 'fr_FR',
  de: 'de_DE',
};

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const description = truncate(cv.about, 160);
const canonicalUrl = `${SITE_URL}${getLocalizedPath(lang)}`;
const ogLocale = OG_LOCALES[lang];
---
<BaseLayout
  lang={lang}
  title={`${cv.hero.name} — ${cv.hero.title}`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogLocale={ogLocale}
>
  <Header lang={lang} ui={cv.ui} name={cv.hero.name} />
  <Hero hero={cv.hero} />
  <About title={cv.ui.sectionTitles.about} about={cv.about} />
  <Experience title={cv.ui.sectionTitles.experience} items={cv.experience} />
  <Projects title={cv.ui.sectionTitles.projects} items={cv.featuredProjects} />
  <Skills title={cv.ui.sectionTitles.skills} skills={cv.skills} />
  <Education title={cv.ui.sectionTitles.education} items={cv.education} />
  <Certifications title={cv.ui.sectionTitles.certifications} items={cv.certifications} />
  <Courses title={cv.ui.sectionTitles.courses} items={cv.courses} />
  <Patents title={cv.ui.sectionTitles.patents} items={cv.patents} />
  <Languages title={cv.ui.sectionTitles.languages} items={cv.languages} />
  <Contact title={cv.ui.sectionTitles.contact} contact={cv.contact} />
  <Footer name={cv.hero.name} />
</BaseLayout>
