---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, WORKERS_URL } from '../site';
import { LANGS, getLocalizedPath } from '../i18n/langs';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Certifications from './Certifications.astro';
import Languages from './Languages.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import CookieConsent from './CookieConsent.astro';
import ScrollToTop from './ScrollToTop.astro';
import type { Lang } from '../i18n/langs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) {
  throw new Error(`Missing CV content for locale "${lang}"`);
}
const cv = entry.data;

const OG_LOCALES: Record<Lang, string> = {
  es: 'es_ES',
  en: 'en_US',
  ca: 'ca_ES',
  pt: 'pt_PT',
  fr: 'fr_FR',
  de: 'de_DE',
};

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const description = truncate(cv.about, 160);
const canonicalUrl = `${SITE_URL}${getLocalizedPath(lang)}`;
const workersUrl = `${WORKERS_URL}${getLocalizedPath(lang)}`;
const ogLocale = OG_LOCALES[lang];
const hreflangLinks = LANGS.map((l) => ({ lang: l, href: `${SITE_URL}${getLocalizedPath(l)}` }));
const defaultHreflangHref = `${SITE_URL}${getLocalizedPath('es')}`;
const sameAs = [cv.contact.linkedin, cv.contact.github, cv.contact.stackoverflow].filter(Boolean);
---
<BaseLayout
  lang={lang}
  title={`${cv.hero.name} — ${cv.hero.title}`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogLocale={ogLocale}
  hreflangLinks={hreflangLinks}
  defaultHreflangHref={defaultHreflangHref}
  personName={cv.hero.name}
  personTitle={cv.hero.title}
  personEmail={cv.contact.email}
  sameAs={sameAs}
>
  <Header lang={lang} ui={cv.ui} name={cv.hero.name} />
  <Hero hero={cv.hero} />
  <About title={cv.ui.sectionTitles.about} about={cv.about} />
  <Skills title={cv.ui.sectionTitles.skills} skills={cv.skills} />
  <Experience title={cv.ui.sectionTitles.experience} items={cv.experience} />
  <Projects title={cv.ui.sectionTitles.projects} items={cv.featuredProjects} />
  <Education title={cv.ui.sectionTitles.education} items={cv.education} />
  <Certifications
    title={cv.ui.sectionTitles.certifications}
    items={cv.certifications}
    patents={cv.patents}
    patentsTitle={cv.ui.sectionTitles.patents}
    courses={cv.courses}
    coursesTitle={cv.ui.sectionTitles.courses}
  />
  <Languages title={cv.ui.sectionTitles.languages} items={cv.languages} />
  <Contact title={cv.ui.sectionTitles.contact} contact={cv.contact} cloudflareUrl={workersUrl} githubPagesUrl={canonicalUrl} githubActivity={cv.ui.githubActivity} gitlabActivity={cv.ui.gitlabActivity} />
  <Footer name={cv.hero.name} />
  <CookieConsent ui={cv.ui.cookieConsent} />
  <ScrollToTop label={cv.ui.scrollToTop} />
</BaseLayout>
