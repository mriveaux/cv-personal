---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  items: CvData['featuredProjects'];
}

const { title, items } = Astro.props;
---
<section id="projects" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-6 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="folder" />
    {title}
  </h2>
  <div class="grid gap-6 sm:grid-cols-2">
    {items.map((project, i) => (
      <article
        class="stagger-item rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:-translate-y-0.5 hover:scale-[1.02] hover:border-indigo-200 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-800"
        style={`--stagger-index: ${i}`}
      >
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">
          {project.url ? (
            <a href={project.url} class="text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300" target="_blank" rel="noopener">{project.name}</a>
          ) : (
            project.name
          )}
        </h3>
        <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{project.description}</p>
      </article>
    ))}
  </div>
</section>
