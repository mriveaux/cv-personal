---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  items: CvData['courses'];
}

const { title, items } = Astro.props;
---
<section id="courses" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="book-open" />
    {title}
  </h2>
  {items.map((course) => (
    <div class="mb-2">
      <p class="font-semibold text-slate-900 dark:text-slate-100">{course.name}</p>
      <p class="text-slate-600 dark:text-slate-400">{course.provider} · {course.year}</p>
    </div>
  ))}
</section>
