---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  items: CvData['patents'];
}

const { title, items } = Astro.props;
---
<section id="patents" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-4 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="bulb" />
    {title}
  </h2>
  <div class="space-y-3">
    {items.map((patent, i) => (
      <div
        class="stagger-item rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:-translate-y-0.5 hover:scale-[1.01] hover:border-indigo-200 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-800"
        style={`--stagger-index: ${i}`}
      >
        <p class="font-semibold text-slate-900 dark:text-slate-100">{patent.title}</p>
        <p class="text-slate-600 dark:text-slate-400">{patent.registry}</p>
        <p class="text-slate-600 dark:text-slate-400">{patent.number} · {patent.date}</p>
        <p class="text-slate-600 dark:text-slate-400">{patent.authors.join(', ')}</p>
      </div>
    ))}
  </div>
</section>
