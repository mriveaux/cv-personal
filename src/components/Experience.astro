---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  items: CvData['experience'];
}

const { title, items } = Astro.props;
---
<section id="experience" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-6 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="briefcase" />
    {title}
  </h2>
  <ol class="space-y-8 border-l-2 border-indigo-100 pl-6 dark:border-indigo-950">
    {items.map((job, i) => (
      <li class="stagger-item relative" style={`--stagger-index: ${i}`}>
        <span class="absolute -left-[29px] top-1 h-3 w-3 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500 ring-4 ring-white dark:ring-slate-900"></span>
        <p class="text-sm text-slate-400 dark:text-slate-500">{job.period} · {job.location}</p>
        <p class="font-semibold text-slate-900 dark:text-slate-100">
          {job.role} —{' '}
          {job.url ? (
            <a href={job.url} class="text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300" target="_blank" rel="noopener">{job.company}</a>
          ) : (
            job.company
          )}
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700 dark:text-slate-300">
          {job.highlights.map((highlight) => (
            <li>
              {typeof highlight === 'string'
                ? highlight
                : highlight.map((part) =>
                    typeof part === 'string' ? (
                      part
                    ) : (
                      <a href={part.url} class="text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300" target="_blank" rel="noopener">{part.text}</a>
                    ),
                  )}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
