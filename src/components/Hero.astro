---
import { Image } from 'astro:assets';
import type { CvData } from '../content/cv.schema';
import avatar from '../assets/avatars/avatar_1.jpeg';

interface Props {
  hero: CvData['hero'];
}

const { hero } = Astro.props;
---
<section id="hero" class="relative overflow-hidden px-6 py-20 text-center">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-indigo-50 via-violet-50/40 to-transparent dark:from-indigo-950/40 dark:via-violet-950/10"></div>
  <Image
    src={avatar}
    alt={hero.name}
    width={128}
    height={128}
    class="mx-auto mb-6 h-32 w-32 rounded-full object-cover ring-4 ring-indigo-100 dark:ring-indigo-900"
  />
  <h1 class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl dark:from-indigo-400 dark:to-violet-400">{hero.name}</h1>
  <p class="mt-2 text-xl text-slate-600 dark:text-slate-300">{hero.title}</p>
  <p class="mt-1 text-sm text-slate-400 dark:text-slate-500">{hero.location}</p>
</section>
