---
import { Image } from 'astro:assets';
import type { CvData } from '../content/cv.schema';
import avatar from '../assets/avatars/avatar_1.jpeg';

interface Props {
  hero: CvData['hero'];
}

const { hero } = Astro.props;
---
<section id="hero" class="relative overflow-hidden px-6 py-20 text-center">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-indigo-50 via-violet-50/40 to-transparent dark:from-indigo-950/40 dark:via-violet-950/10"></div>
  <div class="no-print pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <svg class="hero-parallax-layer h-[130%] w-full text-indigo-500/[0.07] dark:text-indigo-400/[0.09]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="dev-pattern" width="220" height="220" patternUnits="userSpaceOnUse" patternTransform="rotate(-8)">
          <text x="8" y="40" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="30" font-weight="600" fill="currentColor">&lt;/&gt;</text>
          <text x="130" y="30" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="24" font-weight="600" fill="currentColor">{'{ }'}</text>
          <text x="20" y="120" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="22" font-weight="600" fill="currentColor">$_</text>
          <text x="150" y="150" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="26" font-weight="600" fill="currentColor">01</text>
          <circle cx="185" cy="70" r="16" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M185 54v-6M185 92v-6M169 70h-6M207 70h-6M173.7 58.7l-4.2-4.2M200.5 85.5l-4.2-4.2M173.7 81.3l-4.2 4.2M200.5 54.5l-4.2 4.2" stroke="currentColor" stroke-width="2" />
          <path d="M40 165 L55 180 L40 195 M75 165 L60 195" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dev-pattern)" />
    </svg>
  </div>
  <Image
    src={avatar}
    alt={hero.name}
    width={128}
    height={128}
    class="avatar-glow mx-auto mb-6 h-32 w-32 rounded-full object-cover ring-4 ring-indigo-100 transition-transform duration-300 hover:scale-105 dark:ring-indigo-900"
  />
  <h1 class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl dark:from-indigo-400 dark:to-violet-400">{hero.name}</h1>
  <p class="mt-2 text-xl text-slate-600 dark:text-slate-300">{hero.title}</p>
  <p class="mt-1 text-sm text-slate-400 dark:text-slate-500">{hero.location}</p>
</section>

<script>
  const layer = document.querySelector<SVGElement>('.hero-parallax-layer');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (layer && !reduceMotion) {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          layer.style.transform = `translateY(${window.scrollY * 0.12}px)`;
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>
