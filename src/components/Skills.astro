---
import type { CvData } from '../content/cv.schema';
import SectionIcon from './SectionIcon.astro';

interface Props {
  title: string;
  skills: CvData['skills'];
}

const { title, skills } = Astro.props;
---
<section id="skills" class="mx-auto max-w-2xl px-6 py-10">
  <h2 class="mb-6 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    <SectionIcon name="chip" />
    {title}
  </h2>
  <div class="grid items-start gap-4 sm:grid-cols-2">
    {skills.categories.map((category) => (
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-indigo-200 dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-800">
        <h3 class="mb-3 font-semibold text-slate-800 dark:text-slate-200">{category.name}</h3>
        <ul class="flex flex-wrap gap-2">
          {category.items.map((item, i) => (
            <li
              class="stagger-item cursor-default rounded-full bg-indigo-50 px-3 py-1 text-sm text-indigo-700 hover:-translate-y-0.5 hover:scale-110 hover:bg-indigo-100 hover:shadow-md dark:bg-indigo-950/50 dark:text-indigo-300 dark:hover:bg-indigo-900/60"
              style={`--stagger-index: ${i}`}
            >
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
